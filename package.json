{
  "name": "seidr-monorepo",
  "description": "Monorepo for Seidr reactive UI framework and addons",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "FimbulWorks <contact@fimbul.works>",
  "homepage": "https://github.com/fimbul-works/seidr#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fimbul-works/seidr.git"
  },
  "bugs": {
    "url": "https://github.com/fimbul-works/seidr/issues"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "test": "npx vitest",
    "build": "turbo run build",
    "build:all": "pnpm run build && pnpm run sizes",
    "types": "turbo run types",
    "publish": "pnpm run build && pnpm run types && pnpm run release:only",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "biome format --write",
    "check-types": "turbo run check-types",
    "sizes": "npx bundle-size"
  },
  "dependencies": {
    "@fimbul-works/futhark": "^1.1.0",
    "@fimbul-works/hash": "^1.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@fimbul-works/bundle-size": "^2.0.0",
    "@fimbul-works/loiske": "link:../loiske",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "magic-string": "^1.4.3",
    "oxc-parser": "^0.153.0",
    "jsdom": "^30.1.2",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.12",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "turbo": "2.10.12",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "pnpm": "^12.3.4",
    "node": ">=24"
  }
}
