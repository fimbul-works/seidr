{
  "name": "@example/build-tools",
  "description": "Cross-bundler example application and verification suite for @fimbul-works/seidr-build-tools",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsx scripts/build-all.ts",
    "build:webpack": "tsx scripts/build-webpack.ts",
    "build:vite": "tsx scripts/build-vite.ts",
    "build:rollup": "tsx scripts/build-rollup.ts",
    "build:rolldown": "tsx scripts/build-rolldown.ts",
    "build:esbuild": "tsx scripts/build-esbuild.ts",
    "build:babel": "tsx scripts/build-babel.ts",
    "test": "vitest run",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@fimbul-works/seidr": "workspace:*",
    "@fimbul-works/seidr-build-tools": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@babel/preset-typescript": "^7.26.0",
    "@repo/typescript-config": "workspace:*",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@types/babel__core": "^7.20.5",
    "babel-loader": "^10.1.1",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.2",
    "rolldown": "^1.2.13",
    "rollup": "^4.34.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "webpack": "^5.98.0"
  }
}
